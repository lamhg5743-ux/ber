# ==========================================
# 1. LÕI THUẬT TOÁN MA TRẬN VI BA
# ==========================================
class MicrowaveEngine:

  @staticmethod
  def y_to_s(Y: np.ndarray, Z0: float = 50.0) -> np.ndarray:
    N = Y.shape[0]
    I = np.eye(N, dtype=complex)
    Y_bar = Y * Z0
    return np.dot(I - Y_bar, np.linalg.inv(I + Y_bar))

  @staticmethod
  def s_to_y(S: np.ndarray, Z0: float = 50.0) -> np.ndarray:
    N = S.shape[0]
    I = np.eye(N, dtype=complex)
    return np.dot(I - S, np.linalg.inv(I + S)) / Z0

  @staticmethod
  def abcd_to_s(ABCD: np.ndarray, Z0: float = 50.0) -> np.ndarray:
    A, B, C, D = ABCD[0, 0], ABCD[0, 1], ABCD[1, 0], ABCD[1, 1]
    delta = A + (B / Z0) + (C * Z0) + D
    det_abcd = A * D - B * C
    return np.array(
        [
            [(A + (B / Z0) - (C * Z0) - D) / delta, 2.0 * det_abcd / delta],
            [2.0 / delta, (-A + (B / Z0) - (C * Z0) + D) / delta],
        ],
        dtype=complex,
    )

  @staticmethod
  def s_to_abcd(S: np.ndarray, Z0: float = 50.0) -> np.ndarray:
    S11, S12 = S[0, 0], S[0, 1]
    S21, S22 = S[1, 0], S[1, 1]
    return np.array(
        [
            [
                ((1.0 + S11) * (1.0 - S22) + S12 * S21) / (2.0 * S21),
                Z0 * (((1.0 + S11) * (1.0 + S22) - S12 * S21) / (2.0 * S21)),
            ],
            [
                (1.0 / Z0)
                * (((1.0 - S11) * (1.0 - S22) - S12 * S21) / (2.0 * S21)),
                ((1.0 - S11) * (1.0 + S22) + S12 * S21) / (2.0 * S21),
            ],
        ],
        dtype=complex,
    )

  @staticmethod
  def check_properties(S: np.ndarray) -> dict:
    tol = 1e-5
    is_reciprocal = np.allclose(S, S.T, atol=tol)
    is_symmetric = np.isclose(S[0, 0], S[1, 1], atol=tol) and np.isclose(
        S[0, 1], S[1, 0], atol=tol
    )
    is_lossless = np.allclose(
        np.dot(np.conjugate(S.T), S), np.eye(S.shape[0]), atol=tol
    )
    return {
        "Reciprocal": is_reciprocal,
        "Symmetric": is_symmetric,
        "Lossless": is_lossless,
    }


